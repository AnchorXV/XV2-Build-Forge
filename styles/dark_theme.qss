/* ── Global ─────────────────────────────────────────────────────────── */
QMainWindow, QDialog {
    background-color: #1A242D;
    color: #BDDDFC;
    font-size: 13px;
}

QWidget {
    color: #BDDDFC;
}

QScrollArea, QScrollArea > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

/* ── Menu Bar ───────────────────────────────────────────────────────── */
QMenuBar {
    background-color: #1A242D;
    color: #6A89A7;
    border-bottom: 1px solid #384959;
    padding: 4px 8px;
}

QMenuBar::item {
    padding: 5px 10px;
    border-radius: 6px;
    background: transparent;
}

QMenuBar::item:selected {
    background-color: #384959;
    color: #BDDDFC;
}

QMenu {
    background-color: #384959;
    color: #BDDDFC;
    border: 1px solid #6A89A7;
    border-radius: 8px;
    padding: 6px;
    icon-size: 14px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #88BDF2;
    color: #1A242D;
}

QMenu::separator {
    height: 1px;
    background-color: #6A89A7;
    margin: 4px 8px;
}

QMenu::icon {
    padding-left: 8px;
    padding-right: 2px;
}

/* ── Sidebar ────────────────────────────────────────────────────────── */
QWidget#sidebar {
    background-color: #384959;
    border-right: 1px solid #1A242D;
}

QLabel#sidebarSection {
    color: #6A89A7;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    padding: 12px 14px 4px 14px;
}

QLabel#sidebarVersion {
    color: #6A89A7;
    font-size: 10px;
    padding: 8px;
}

QPushButton#sidebarButton {
    background-color: transparent;
    color: #6A89A7;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
    margin: 2px 6px;
}

QPushButton#sidebarButton:hover {
    background-color: #1A242D;
    color: #BDDDFC;
}

QPushButton#sidebarButton:checked {
    background-color: #1A242D;
    color: #BDDDFC;
    font-weight: 600;
}

/* ── Section Header ─────────────────────────────────────────────────── */
QLabel#sectionHeaderTitle {
    color: #88BDF2;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

QFrame#sectionHeaderLine {
    background-color: #384959;
    border: none;
}

/* ── Panel Header ───────────────────────────────────────────────────── */
QLabel#panelHeader {
    color: #6A89A7;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 4px 2px;
}

QLabel#emptyStateLabel {
    color: #6A89A7;
    font-size: 14px;
    font-style: italic;
}

/* ── Buttons ────────────────────────────────────────────────────────── */
QPushButton {
    background-color: #384959;
    color: #BDDDFC;
    border: 1px solid #6A89A7;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #4a5d73;
    border-color: #88BDF2;
}

QPushButton:pressed {
    background-color: #1A242D;
}

QPushButton#primaryButton {
    background-color: #88BDF2;
    color: #1A242D;
    border: none;
    font-weight: 600;
    padding: 9px 20px;
}

QPushButton#primaryButton:hover {
    background-color: #9ECDF5;
}

QPushButton#primaryButton:pressed {
    background-color: #6A89A7;
}

QPushButton#secondaryButton {
    background-color: transparent;
    color: #6A89A7;
    border: 1px solid #6A89A7;
    font-weight: 500;
    padding: 7px 12px;
    font-size: 12px;
}

QPushButton#secondaryButton:hover {
    background-color: #384959;
    color: #BDDDFC;
    border-color: #88BDF2;
}

QPushButton#secondaryButton:disabled {
    color: #4a5d73;
    border-color: #4a5d73;
}

QPushButton#dangerButton {
    background-color: transparent;
    color: #6A89A7;
    border: 1px solid #6A89A7;
    font-weight: 500;
    padding: 7px 12px;
    font-size: 12px;
}

QPushButton#dangerButton:hover {
    background-color: #3d1a1e;
    border-color: #e5484d;
    color: #ffbdbd;
}

QPushButton#addButton {
    background-color: #88BDF2;
    color: #1A242D;
    border: none;
    font-size: 18px;
    font-weight: 600;
    border-radius: 8px;
    padding: 0;
}

QPushButton#addButton:hover {
    background-color: #9ECDF5;
}

/* ── Inputs ──────────────────────────────────────────────────────────── */
QLineEdit, QComboBox, QSpinBox {
    background-color: #1A242D;
    color: #BDDDFC;
    border: 1px solid #6A89A7;
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 13px;
    selection-background-color: #88BDF2;
    selection-color: #1A242D;
    min-height: 18px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #88BDF2;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    color: #4a5d73;
    background-color: #1A242D;
}

/* ── ComboBox ────────────────────────────────────────────────────────── */
QComboBox QLineEdit {
    background-color: transparent;
    border: none;
    padding: 0;
}

QComboBox::drop-down {
    border: none;
    width: 32px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}

QComboBox::down-arrow {
    image: url(assets/icons/chevron_up.svg);
    width: 12px;
    height: 12px;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #384959;
    color: #BDDDFC;
    border: 1px solid #6A89A7;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: #88BDF2;
    selection-color: #1A242D;
}

QComboBox QAbstractItemView::item {
    padding: 7px 10px;
    border-radius: 6px;
    min-height: 20px;
}

QAbstractItemView {
    background-color: #384959;
    color: #BDDDFC;
    border: 1px solid #6A89A7;
    border-radius: 8px;
    selection-background-color: #88BDF2;
    selection-color: #1A242D;
    outline: none;
}

/* ── Table View ─────────────────────────────────────────────────────── */
QTableView, QTableWidget {
    background-color: #1A242D;
    alternate-background-color: #1f2d38;
    gridline-color: transparent;
    border: 1px solid #384959;
    border-radius: 10px;
    color: #BDDDFC;
    selection-background-color: #88BDF2;
    selection-color: #1A242D;
    outline: none;
}

QTableView::item, QTableWidget::item {
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #384959;
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: #88BDF2;
    color: #1A242D;
}

QTableView::item:hover, QTableWidget::item:hover {
    background-color: #384959;
}

QTableView::item:selected:hover {
    background-color: #9ECDF5;
}

QHeaderView {
    background-color: transparent;
}

QHeaderView::section {
    background-color: #384959;
    color: #6A89A7;
    font-size: 11px;
    font-weight: 700;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #6A89A7;
    text-align: left;
}

QHeaderView::section:hover {
    color: #BDDDFC;
}

/* Sheet List (panel kiri) — borderless */
QTableView#sheetList {
    background-color: transparent;
    border: none;
    border-radius: 0;
}

QTableView#sheetList::item {
    padding: 8px 12px;
    color: #6A89A7;
    border: none;
    border-radius: 6px;
    margin: 1px 4px;
}

QTableView#sheetList::item:selected {
    background-color: #88BDF2;
    color: #1A242D;
}

QTableView#sheetList::item:hover {
    background-color: #384959;
    color: #BDDDFC;
}

/* ── Labels ──────────────────────────────────────────────────────────── */
QLabel {
    color: #BDDDFC;
    background: transparent;
}

QLabel#hintLabel {
    color: #6A89A7;
    font-style: italic;
    font-size: 12px;
}

/* ── Scroll Bars ─────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #6A89A7;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #88BDF2;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #6A89A7;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #88BDF2;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ── Splitter ───────────────────────────────────────────────────────── */
QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:horizontal {
    width: 6px;
}

QSplitter::handle:hover {
    background-color: #6A89A7;
}

/* ── Tooltip ─────────────────────────────────────────────────────────── */
QToolTip {
    background-color: #384959;
    color: #BDDDFC;
    border: 1px solid #6A89A7;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ── Message Box ─────────────────────────────────────────────────────── */
QMessageBox {
    background-color: #1A242D;
}

QMessageBox QLabel {
    color: #BDDDFC;
    font-size: 13px;
}

QDialogButtonBox QPushButton {
    min-width: 84px;
}

/* ── Card Frame ─────────────────────────────────────────────────────── */
QFrame#cardFrame {
    background-color: #384959;
    border: 1px solid #6A89A7;
    border-radius: 10px;
}

/* ── Field Label ────────────────────────────────────────────────────── */
QLabel#fieldLabel {
    color: #6A89A7;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3px;
}

QLabel#previewLabel {
    color: #6A89A7;
    font-size: 12px;
    padding: 8px 0;
}

/* ── Status Bar ─────────────────────────────────────────────────────── */
QStatusBar {
    background-color: #1A242D;
    color: #6A89A7;
    border-top: 1px solid #384959;
    padding: 4px 12px;
    font-size: 12px;
}

/* ── Edit Banner ────────────────────────────────────────────────────── */
QFrame#editBanner {
    background-color: #1e1610;
    border: none;
    border-bottom: 1px solid #d4740a;
    border-radius: 0;
}

QLabel#editBannerLabel {
    color: #f5b066;
    font-size: 13px;
    font-weight: 500;
    padding: 0;
}

QPushButton#editBannerCancel {
    background-color: transparent;
    color: #f5b066;
    border: none;
    border-radius: 4px;
    font-size: 18px;
    font-weight: 600;
    padding: 0;
}

QPushButton#editBannerCancel:hover {
    background-color: #3d2a15;
    color: #ffffff;
}

QPushButton#editBannerCancel:pressed {
    background-color: #2a1c0d;
}

QPushButton#updateButton {
    background-color: #d4740a;
    color: #ffffff;
    border: none;
    font-weight: 600;
    padding: 9px 20px;
}

QPushButton#updateButton:hover {
    background-color: #e68a1a;
}

QPushButton#updateButton:pressed {
    background-color: #b86208;
}

/* ── PlainTextEdit / TextEdit ───────────────────────────────────────── */
QPlainTextEdit, QTextEdit {
    background-color: #1A242D;
    color: #BDDDFC;
    border: 1px solid #6A89A7;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: #88BDF2;
    selection-color: #1A242D;
}

QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid #88BDF2;
}

/* ── Panels ─────────────────────────────────────────────────────────── */
QFrame#characterDetailPanel, QFrame#databaseDetailPanel {
    background-color: #1A242D;
    border: 1px solid #384959;
    border-radius: 10px;
}

QLabel#panelTitle {
    color: #BDDDFC;
    font-size: 16px;
    font-weight: 600;
    padding: 4px 0;
}

QLabel#panelInfo {
    color: #6A89A7;
    font-size: 12px;
    padding: 4px 0;
}

QLabel#panelFieldLabel {
    color: #6A89A7;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3px;
    padding: 2px 0;
}

QLabel#panelValue {
    color: #BDDDFC;
    font-size: 13px;
    padding: 2px 0;
}

QLabel#panelValueInline {
    color: #BDDDFC;
    font-size: 13px;
    padding: 2px 0;
}

QListWidget#panelList {
    background-color: #1A242D;
    border: 1px solid #6A89A7;
    border-radius: 6px;
    padding: 4px;
    outline: none;
    font-size: 12px;
}

QListWidget#panelList::item {
    color: #BDDDFC;
    padding: 5px 8px;
    border-radius: 4px;
}

QListWidget#panelList::item:selected {
    background-color: #88BDF2;
    color: #1A242D;
}

QListWidget#panelList::item:hover {
    background-color: #384959;
}

QScrollArea#characterDetailScroll {
    background-color: transparent;
    border: none;
}

/* ── Warnings ───────────────────────────────────────────────────────── */
QComboBox[warningState="true"] {
    border: 1px solid #d4740a;
    background-color: #1e1610;
}

QComboBox[warningState="true"]:focus {
    border: 1px solid #e68a1a;
    background-color: #251a12;
}

QLabel#inlineWarning {
    color: #f5b066;
    font-size: 12px;
    padding: 6px 4px;
}

QLabel#formWarning {
    color: #f5b066;
    font-size: 12px;
    padding: 8px 12px;
    background-color: #1e1610;
    border: 1px solid #d4740a;
    border-radius: 6px;
}