/* ── Global ─────────────────────────────────────────────────────────── */
QMainWindow, QDialog {
    background-color: #1e1e1e;
    color: #d4d4d4;
    font-family: "SF Pro Display", "SF Pro Text", "SF Pro", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 13px;
}

QWidget {
    color: #d4d4d4;
    font-family: "SF Pro Display", "SF Pro Text", "SF Pro", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

QScrollArea, QScrollArea > QWidget > QWidget {
    background-color: #1e1e1e;
    border: none;
}

/* ── Menu Bar ───────────────────────────────────────────────────────── */
QMenuBar {
    background-color: #252526;
    color: #d4d4d4;
    border-bottom: 1px solid #3c3c3c;
    padding: 2px;
}

QMenuBar::item:selected {
    background-color: #2b5797;
    color: #ffffff;
    border-radius: 3px;
}

QMenu {
    background-color: #2d2d30;
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
}

QMenu::item:selected {
    background-color: #2b5797;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #3c3c3c;
    margin: 4px 8px;
}

/* ── Tab Widget ─────────────────────────────────────────────────────── */
QTabWidget {
    background-color: #1e1e1e;
}

QTabWidget::tab-bar {
    alignment: left;
    background-color: #1e1e1e;
}

QTabBar {
    background-color: #1e1e1e;
    qproperty-drawBase: 0;
}

QTabWidget::pane {
    border: 1px solid #3c3c3c;
    background-color: #252526;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #2d2d30;
    color: #d4d4d4;
    padding: 7px 16px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border: 1px solid #3c3c3c;
    border-bottom: none;
}

QTabBar::tab:selected {
    background-color: #252526;
    color: #ffffff;
    font-weight: bold;
    border-bottom: 2px solid #2b5797;
}

QTabBar::tab:hover:!selected {
    background-color: #383838;
    color: #ffffff;
}

QTabBar QToolButton {
    background-color: #2d2d30;
    color: #ffffff;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
}

QTabBar QToolButton:hover {
    background-color: #383838;
}

/* ── Table View ─────────────────────────────────────────────────────── */
QTableView, QTableWidget {
    background-color: #1e1e1e;
    alternate-background-color: #252526;
    gridline-color: #3c3c3c;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    selection-background-color: #264f78;
    selection-color: #FFFFFF;
    color: #FFFFFF;
}

QTableView::item, QTableWidget::item {
    color: #FFFFFF;
    padding: 5px 8px;
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: #2563EB;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #2d2d30;
    color: #ffffff;
    font-weight: bold;
    padding: 6px 10px;
    border: none;
    border-right: 1px solid #3c3c3c;
    border-bottom: 1px solid #3c3c3c;
}

/* ── Buttons ────────────────────────────────────────────────────────── */
QPushButton {
    background-color: #3c3c3c;
    color: #d4d4d4;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 6px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #4a4a4a;
    border-color: #2b5797;
}

QPushButton:pressed {
    background-color: #555555;
}

QPushButton#addButton {
    background-color: #2b5797;
    color: #ffffff;
    border: none;
    font-size: 18px;
    font-weight: bold;
    padding: 0;
    margin: 0;
    border-radius: 4px;
}

QPushButton#addButton:hover {
    background-color: #3568aa;
}

QPushButton#saveButton {
    background-color: #2b5797;
    color: #ffffff;
    border: none;
    padding: 8px 18px;
}

QPushButton#saveButton:hover {
    background-color: #3568aa;
}

QPushButton#updateButton {
    background-color: #d4740a;
    color: #ffffff;
    border: none;
    padding: 8px 18px;
}

QPushButton#updateButton:hover {
    background-color: #e68a1a;
}

QPushButton#exportButton {
    background-color: #1e7145;
    color: #ffffff;
    border: none;
    padding: 8px 20px;
}

QPushButton#exportButton:hover {
    background-color: #258a55;
}

QPushButton#resetButton {
    background-color: #3c3c3c;
    color: #d4d4d4;
}

/* ── Inputs ──────────────────────────────────────────────────────────── */
QComboBox, QSpinBox, QLineEdit {
    background-color: #2d2d30;
    color: #FFFFFF;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 5px 8px;
}

QComboBox QLineEdit, QComboBox:editable, QComboBox:editable QLineEdit {
    background-color: #2d2d30;
    color: #FFFFFF;
    selection-background-color: #264f78;
    selection-color: #FFFFFF;
}

QComboBox:focus, QSpinBox:focus, QLineEdit:focus {
    border-color: #2b5797;
}

QComboBox {
    padding-right: 30px;
}

QComboBox::drop-down {
    border-left: 1px solid #555555;
    width: 26px;
}

QAbstractItemView {
    background-color: #252526;
    color: #FFFFFF;
    border: 1px solid #555555;
    selection-background-color: #264f78;
    selection-color: #FFFFFF;
}

QComboBox QAbstractItemView {
    background-color: #252526;
    border: 1px solid #555555;
    selection-background-color: #264f78;
    selection-color: #FFFFFF;
    color: #FFFFFF;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    background-color: #252526;
    color: #FFFFFF;
    padding: 6px 10px;
    min-height: 24px;
}

QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background-color: #264f78;
    color: #FFFFFF;
}

/* ── Labels ──────────────────────────────────────────────────────────── */
QLabel {
    color: #d4d4d4;
}

QLabel#hintLabel {
    color: #808080;
    font-style: italic;
    font-size: 12px;
}

/* ── Scroll Bars ─────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: #1e1e1e;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #555555;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #6e6e6e;
}

QScrollBar:horizontal {
    background: #1e1e1e;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #555555;
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #6e6e6e;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

/* ── Tooltip ─────────────────────────────────────────────────────────── */
QToolTip {
    background-color: #2d2d30;
    color: #d4d4d4;
    border: 1px solid #555555;
    padding: 4px 6px;
}

/* ── Message Box ─────────────────────────────────────────────────────── */
QMessageBox {
    background-color: #252526;
    color: #d4d4d4;
}

QMessageBox QLabel {
    color: #d4d4d4;
}

/* ── Dialog Button Box ───────────────────────────────────────────────── */
QDialogButtonBox QPushButton {
    min-width: 80px;
}

/* ── Sidebar ────────────────────────────────────────────────────────── */
QWidget#sidebar {
    background-color: #181818;
    border-right: 1px solid #2a2a2a;
}

QLabel#sidebarSection {
    color: #6a6a6a;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 8px 8px 2px 8px;
}

QLabel#sidebarVersion {
    color: #4a4a4a;
    font-size: 10px;
}

QPushButton#sidebarButton {
    background-color: transparent;
    color: #b0b0b0;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    text-align: left;
    font-size: 13px;
    font-weight: normal;
}

QPushButton#sidebarButton:hover {
    background-color: #2a2a2a;
    color: #e0e0e0;
}

QPushButton#sidebarButton:checked {
    background-color: #2b5797;
    color: #ffffff;
    font-weight: bold;
}

QPushButton#sidebarButton:checked:hover {
    background-color: #3568aa;
}

/* ── Section Header (ganti group box) ───────────────────────────────── */
QLabel#sectionHeaderTitle {
    color: #6a6a6a;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1.5px;
}

QFrame#sectionHeaderLine {
    background-color: #2a2a2a;
    border: none;
}

/* ── Roster Split View ──────────────────────────────────────────────── */
QSplitter#rosterSplitter::handle {
    background-color: #2a2a2a;
}

QSplitter#rosterSplitter::handle:horizontal {
    width: 4px;
}

QSplitter#rosterSplitter::handle:hover {
    background-color: #2b5797;
}

QLabel#panelHeader {
    color: #6a6a6a;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 4px 2px;
}

QLabel#emptyStateLabel {
    color: #5a5a5a;
    font-size: 14px;
    font-style: italic;
}

QPushButton#secondaryButton {
    background-color: #2d2d30;
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: normal;
}

QPushButton#secondaryButton:hover {
    background-color: #3c3c3c;
    border-color: #2b5797;
}

QPushButton#secondaryButton:disabled {
    color: #5a5a5a;
    border-color: #2a2a2a;
}

QPushButton#dangerButton {
    background-color: #2d2d30;
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: normal;
}

QPushButton#dangerButton:hover {
    background-color: #7a2828;
    border-color: #a03030;
    color: #ffffff;
}

QPushButton#dangerButton:disabled {
    color: #5a5a5a;
    border-color: #2a2a2a;
}

QTableView#sheetList {
    background-color: #1e1e1e;
    border: 1px solid #2a2a2a;
    border-radius: 4px;
}

QTableView#sheetList::item {
    padding: 8px 10px;
    color: #d4d4d4;
    border-bottom: 1px solid #232323;
}

QTableView#sheetList::item:selected {
    background-color: #2b5797;
    color: #ffffff;
}

QTableView#sheetList::item:hover {
    background-color: #252526;
}

/* ── Command Palette ────────────────────────────────────────────────── */
QDialog {
    background-color: #252526;
}

QLineEdit#commandPaletteInput {
    background-color: #1e1e1e;
    color: #ffffff;
    border: 2px solid #2b5797;
    border-radius: 0;
    padding: 12px 16px;
    font-size: 15px;
}

QFrame#commandPaletteDivider {
    background-color: #2b5797;
    border: none;
}

QListWidget#commandPaletteList {
    background-color: #252526;
    border: none;
    outline: none;
    padding: 4px;
    max-height: 280px;
}

QListWidget#commandPaletteList::item {
    color: #d4d4d4;
    padding: 8px 12px;
    border-radius: 4px;
}

QListWidget#commandPaletteList::item:selected {
    background-color: #2b5797;
    color: #ffffff;
}

QListWidget#commandPaletteList::item:hover {
    background-color: #2d2d30;
}

QLabel#commandPaletteEmpty {
    color: #6a6a6a;
    font-style: italic;
    padding: 20px;
}