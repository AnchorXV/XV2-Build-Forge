/* ── Global ─────────────────────────────────────────────────────────── */
QMainWindow, QDialog {
    background-color: #0c0d10;
    color: #e8e8ec;
    font-size: 13px;
}

QWidget {
    color: #e8e8ec;
}

QScrollArea, QScrollArea > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

/* ── Menu Bar ───────────────────────────────────────────────────────── */
QMenuBar {
    background-color: #0c0d10;
    color: #b0b0b8;
    border-bottom: 1px solid #1a1b1f;
    padding: 4px 8px;
}

QMenuBar::item {
    padding: 5px 10px;
    border-radius: 6px;
    background: transparent;
}

QMenuBar::item:selected {
    background-color: #1a1b1f;
    color: #ffffff;
}

QMenu {
    background-color: #16171a;
    color: #e8e8ec;
    border: 1px solid #232428;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 14px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #6366f1;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #232428;
    margin: 4px 8px;
}

/* ── Sidebar ────────────────────────────────────────────────────────── */
QWidget#sidebar {
    background-color: #0a0a0c;
    border-right: 1px solid #1a1b1f;
}

QLabel#sidebarSection {
    color: #52535c;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    padding: 12px 14px 4px 14px;
}

QLabel#sidebarVersion {
    color: #3a3b42;
    font-size: 10px;
    padding: 8px;
}

QPushButton#sidebarButton {
    background-color: transparent;
    color: #8b8c93;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
    margin: 2px 6px;
}

QPushButton#sidebarButton:hover {
    background-color: #16171a;
    color: #e8e8ec;
}

QPushButton#sidebarButton:checked {
    background-color: #1c1d23;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#sidebarButton:checked:hover {
    background-color: #232428;
}

/* ── Section Header ─────────────────────────────────────────────────── */
QLabel#sectionHeaderTitle {
    color: #6366f1;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

QFrame#sectionHeaderLine {
    background-color: #1a1b1f;
    border: none;
}

/* ── Panel Header ───────────────────────────────────────────────────── */
QLabel#panelHeader {
    color: #52535c;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 4px 2px;
}

QLabel#emptyStateLabel {
    color: #4a4b52;
    font-size: 14px;
    font-style: italic;
}

/* ── Buttons ────────────────────────────────────────────────────────── */
QPushButton {
    background-color: #1a1b1f;
    color: #e8e8ec;
    border: 1px solid #232428;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #232428;
    border-color: #2e3038;
}

QPushButton:pressed {
    background-color: #16171a;
}

QPushButton#saveButton {
    background-color: #6366f1;
    color: #ffffff;
    border: none;
    font-weight: 600;
    padding: 9px 20px;
}

QPushButton#saveButton:hover {
    background-color: #7c7ef5;
}

QPushButton#saveButton:pressed {
    background-color: #5557d8;
}

QPushButton#secondaryButton {
    background-color: #16171a;
    color: #b0b0b8;
    border: 1px solid #232428;
    font-weight: 500;
    padding: 7px 12px;
    font-size: 12px;
}

QPushButton#secondaryButton:hover {
    background-color: #1c1d23;
    border-color: #6366f1;
    color: #ffffff;
}

QPushButton#secondaryButton:disabled {
    color: #3a3b42;
    border-color: #1a1b1f;
}

QPushButton#dangerButton {
    background-color: #16171a;
    color: #b0b0b8;
    border: 1px solid #232428;
    font-weight: 500;
    padding: 7px 12px;
    font-size: 12px;
}

QPushButton#dangerButton:hover {
    background-color: #3d1a1e;
    border-color: #e5484d;
    color: #ffbdbd;
}

QPushButton#dangerButton:disabled {
    color: #3a3b42;
    border-color: #1a1b1f;
}

QPushButton#addButton {
    background-color: #6366f1;
    color: #ffffff;
    border: none;
    font-size: 18px;
    font-weight: 600;
    border-radius: 8px;
    padding: 0;
}

QPushButton#addButton:hover {
    background-color: #7c7ef5;
}

/* ── Inputs ──────────────────────────────────────────────────────────── */
QLineEdit, QComboBox, QSpinBox {
    background-color: #131418;
    color: #e8e8ec;
    border: 1px solid #232428;
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 13px;
    selection-background-color: #6366f1;
    selection-color: #ffffff;
    min-height: 18px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #6366f1;
    background-color: #16171a;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    color: #52535c;
    background-color: #0f1013;
}

/* ── SpinBox ────────────────────────────────────────────────────────── */
QSpinBox {
    padding-right: 30px;
}

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 24px;
    height: 16px;
    border: none;
    background: transparent;
    margin: 3px 3px 0 0;
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 24px;
    height: 16px;
    border: none;
    background: transparent;
    margin: 0 3px 3px 0;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: #1a1b1f;
    border-radius: 4px;
}

QSpinBox::up-arrow {
    image: url(assets/icons/chevron_down.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow {
    image: url(assets/icons/chevron_up.svg);
    width: 10px;
    height: 10px;
}

/* ── ComboBox ────────────────────────────────────────────────────────── */
QComboBox QLineEdit {
    background-color: transparent;
    border: none;
    padding: 0;
}

QComboBox::drop-down {
    border: none;
    width: 32px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}

QComboBox::down-arrow {
    image: url(assets/icons/chevron_up.svg);
    width: 12px;
    height: 12px;
    margin-right: 10px;
}

QComboBox::down-arrow:hover,
QComboBox::down-arrow:on,
QComboBox::down-arrow:pressed {
    image: url(assets/icons/chevron_up.svg);
    width: 12px;
    height: 12px;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #16171a;
    color: #e8e8ec;
    border: 1px solid #232428;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: #6366f1;
    selection-color: #ffffff;
}

QComboBox QAbstractItemView::item {
    padding: 7px 10px;
    border-radius: 6px;
    min-height: 20px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #6366f1;
    color: #ffffff;
}

QAbstractItemView {
    background-color: #16171a;
    color: #e8e8ec;
    border: 1px solid #232428;
    border-radius: 8px;
    selection-background-color: #6366f1;
    selection-color: #ffffff;
    outline: none;
}

/* ── Table View ─────────────────────────────────────────────────────── */
QTableView, QTableWidget {
    background-color: #0f1013;
    alternate-background-color: #131418;
    gridline-color: transparent;
    border: 1px solid #1a1b1f;
    border-radius: 10px;
    color: #d8d8dc;
    selection-background-color: #6366f1;
    selection-color: #ffffff;
    outline: none;
}

QTableView::item, QTableWidget::item {
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #16171a;
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: #6366f1;
    color: #ffffff;
}

QTableView::item:hover, QTableWidget::item:hover {
    background-color: #1a1b1f;
}

QTableView::item:selected:hover {
    background-color: #7c7ef5;
}

QHeaderView {
    background-color: transparent;
}

QHeaderView::section {
    background-color: #0f1013;
    color: #52535c;
    font-size: 11px;
    font-weight: 700;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #1a1b1f;
    text-align: left;
}

QHeaderView::section:hover {
    color: #8b8c93;
}

/* Sheet List (panel kiri) — borderless */
QTableView#sheetList {
    background-color: transparent;
    border: none;
    border-radius: 0;
}

QTableView#sheetList::item {
    padding: 8px 12px;
    color: #b0b0b8;
    border: none;
    border-radius: 6px;
    margin: 1px 4px;
}

QTableView#sheetList::item:selected {
    background-color: #6366f1;
    color: #ffffff;
}

QTableView#sheetList::item:hover {
    background-color: #16171a;
}

/* ── Labels ──────────────────────────────────────────────────────────── */
QLabel {
    color: #e8e8ec;
    background: transparent;
}

QLabel#hintLabel {
    color: #52535c;
    font-style: italic;
    font-size: 12px;
}

/* ── Scroll Bars ─────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #2a2c31;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #3a3c42;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #2a2c31;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #3a3c42;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ── Splitter ───────────────────────────────────────────────────────── */
QSplitter#rosterSplitter::handle {
    background-color: transparent;
}

QSplitter#rosterSplitter::handle:horizontal {
    width: 6px;
}

QSplitter#rosterSplitter::handle:hover {
    background-color: #1a1b1f;
}

/* ── Tooltip ─────────────────────────────────────────────────────────── */
QToolTip {
    background-color: #16171a;
    color: #e8e8ec;
    border: 1px solid #2a2c31;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ── Message Box ─────────────────────────────────────────────────────── */
QMessageBox {
    background-color: #131418;
}

QMessageBox QLabel {
    color: #e8e8ec;
    font-size: 13px;
}

/* ── Dialog Button Box ───────────────────────────────────────────────── */
QDialogButtonBox QPushButton {
    min-width: 84px;
}

/* ── Command Palette ─────────────────────────────────────────────────── */
QDialog {
    background-color: #131418;
}

CommandPalette {
    background-color: #131418;
    border: 1px solid #2a2c31;
    border-radius: 12px;
}

QLineEdit#commandPaletteInput {
    background-color: #0f1013;
    color: #ffffff;
    border: 1px solid #6366f1;
    border-radius: 10px;
    padding: 14px 18px;
    font-size: 15px;
    font-weight: 500;
}

QLineEdit#commandPaletteInput:focus {
    border: 1px solid #7c7ef5;
}

QFrame#commandPaletteDivider {
    background-color: #1a1b1f;
    border: none;
}

QListWidget#commandPaletteList {
    background-color: #131418;
    border: none;
    outline: none;
    padding: 6px;
    max-height: 320px;
}

QListWidget#commandPaletteList::item {
    color: #d8d8dc;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 13px;
}

QListWidget#commandPaletteList::item:selected {
    background-color: #6366f1;
    color: #ffffff;
}

QListWidget#commandPaletteList::item:hover {
    background-color: #1a1b1f;
}

QLabel#commandPaletteEmpty {
    color: #52535c;
    font-style: italic;
    padding: 24px;
}

/* ── Card Frame ─────────────────────────────────────────────────────── */
QFrame#cardFrame {
    background-color: #131418;
    border: 1px solid #1a1b1f;
    border-radius: 10px;
}

/* ── Field Label ────────────────────────────────────────────────────── */
QLabel#fieldLabel {
    color: #8b8c93;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3px;
}

QLabel#previewLabel {
    color: #8b8c93;
    font-size: 12px;
    padding: 8px 0;
}

/* ── Status Bar ─────────────────────────────────────────────────────── */
QStatusBar {
    background-color: #0a0a0c;
    color: #8b8c93;
    border-top: 1px solid #1a1b1f;
    padding: 4px 12px;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}

/* ── Edit Banner ────────────────────────────────────────────────────── */
QFrame#editBanner {
    background-color: #1e1610;
    border: none;
    border-bottom: 1px solid #d4740a;
    border-radius: 0;
}

QLabel#editBannerLabel {
    color: #f5b066;
    font-size: 13px;
    font-weight: 500;
    padding: 0;
}

QPushButton#editBannerCancel {
    background-color: transparent;
    color: #f5b066;
    border: none;
    border-radius: 4px;
    font-size: 18px;
    font-weight: 600;
    padding: 0;
}

QPushButton#editBannerCancel:hover {
    background-color: #3d2a15;
    color: #ffffff;
}

QPushButton#editBannerCancel:pressed {
    background-color: #2a1c0d;
}

/* ── Update Button (menggantikan styling saveButton saat mode edit) ── */
QPushButton#updateButton {
    background-color: #d4740a;
    color: #ffffff;
    border: none;
    font-weight: 600;
    padding: 9px 20px;
}

QPushButton#updateButton:hover {
    background-color: #e68a1a;
}

QPushButton#updateButton:pressed {
    background-color: #b86208;
}

/* ── PlainTextEdit / TextEdit ───────────────────────────────────────── */
QPlainTextEdit, QTextEdit {
    background-color: #131418;
    color: #e8e8ec;
    border: 1px solid #232428;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: #6366f1;
    selection-color: #ffffff;
}

QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid #6366f1;
    background-color: #16171a;
}