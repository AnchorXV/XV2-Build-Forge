# ============================================================
# DBXV2 Build Forge - .gitignore
# ============================================================

# --- Python bytecode & caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Packaging / build artifacts ---
# Panduan build (build/nuitka_build.md) tetap dilacak
build/*
!build/nuitka_build.md
dist/
*.egg-info/
*.spec

# --- Nuitka ---
*.build/
*.dist/
*.onefile-build/
nuitka-crash-report.xml

# --- Compiled binaries & installer output ---
# Distribusikan via GitHub Releases, bukan lewat git
*.exe
*.msi
Output/

# --- Runtime user data (jangan commit data pribadi) ---
build_forge_data.json
build_forge_data.json.bak
build_forge_data.json.tmp
*.bak
*.tmp
# Sample data tetap dilacak
!build_forge_data.sample.json

# --- Exported files (hasil ekspor XLSX/CSV) ---
exports/
*.xlsx
*.csv

# --- Logs & coverage ---
*.log
logs/
.coverage
coverage.xml
htmlcov/

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# Build dan Setup files
PRD_DBXV2_Build_Forge.md
build_onefile.bat
build_optimized.bat
setup.iss
slim_dist.ps1